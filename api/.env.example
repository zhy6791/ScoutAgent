# ===== LLM（智谱 GLM / BigModel，OpenAI 兼容）=====
# 必填：从智谱开放平台 https://open.bigmodel.cn 控制台获取的 API Key
ZHIPU_API_KEY=your_zhipu_api_key_here

# 模型名：默认 glm-5-turbo（质量最高，带思考模式，长输出能力强）
# 备选：glm-4-air（Agent 专用，速度快并发高，适合调试）、glm-4.6（推理模型）
ZHIPU_MODEL=glm-5-turbo
# BigModel OpenAI 兼容网关地址
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ===== 搜索 API（采集 Agent 用）=====
# 可选：serper（推荐）、bocha、serpapi
SEARCH_PROVIDER=serper
# Serper.dev API Key，从 https://serper.dev/dashboard 获取
SERPER_API_KEY=your_serper_api_key_here
SERPER_BASE_URL=https://google.serper.dev/search
# 兼容旧提供商（不使用 Serper 时填写）
BOCHA_API_KEY=
BOCHA_BASE_URL=https://api.bocha.cn/v1
SERPAPI_KEY=
SERPAPI_BASE_URL=https://serpapi.com/search

# ===== 自媒体平台采集器 cookie/token（可选）=====
DOUYIN_COOKIE=
BILIBILI_COOKIE=
XHS_COOKIE=

# ===== 服务配置 =====
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:3400
ENABLE_DEMO_FALLBACK=true

# ===== 竞品订阅监控（Serverless 不运行进程内调度器）=====
SUBSCRIPTION_SCHEDULER_ENABLED=false
MONITOR_TICK_SECONDS=60
MONITOR_MAX_CONCURRENCY=3
MONITOR_DUE_BATCH_SIZE=20
MONITOR_FETCH_TIMEOUT=30
MONITOR_MAX_RESPONSE_BYTES=5000000
MONITOR_MAX_REDIRECTS=5
MONITOR_LEASE_SECONDS=1800
MONITOR_SNAPSHOT_RETENTION=30
MONITOR_MIN_CHANGE_RATIO=0.01
MONITOR_MIN_CHANGED_CHARS=40
MONITOR_DIFF_MAX_CHARS=12000
MONITOR_TARGET_FAILURE_THRESHOLD=3
# Vercel 留空时使用 /tmp/monitor_snapshots，该目录不跨实例持久化。
MONITOR_SNAPSHOT_DIR=
